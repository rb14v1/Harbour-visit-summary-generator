# Copy to .env (inside backend/, or at the repo root for docker compose) and
# fill in real values before running docker compose.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# --- Database (Postgres) ---
POSTGRES_DB=visit_summary_generator
POSTGRES_USER=visit_summary_generator
POSTGRES_PASSWORD=visit_summary_generator
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# DEV-ONLY: set USE_SQLITE=True to run manage.py commands (check,
# makemigrations, test) against local SQLite when Docker/Postgres aren't
# available, e.g. on a bare dev machine. Never set this in
# docker-compose/production. See backend/config/settings/base.py.
USE_SQLITE=False

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api

# --- AI (OpenAI chat-completion for patient-friendly visit summaries) ---
# Leave OPENAI_API_KEY unset to use the deterministic offline stub (default
# for local dev/tests - no network calls, no cost). Set a real key to call
# the OpenAI chat-completions API. See backend/apps/common/ai.py.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.6-sol
