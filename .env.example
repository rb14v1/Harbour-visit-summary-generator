# ─── Harbour SSO / OIDC ─────────────────────────────────────────────────────
# These values must be set in the deployment environment.
# Never commit actual secrets — use a secrets manager or CI/CD secret store.

OIDC_ISSUER=https://your-issuer.example.com
OIDC_CLIENT_ID=your-client-id
OIDC_CLIENT_SECRET=your-client-secret

# ─── AI (single chat-completion call) ───────────────────────────────────────
# Leave OPENAI_API_KEY unset to run entirely on deterministic stubs (no
# network access, no cost). Set it to enable real generated summaries.
# See backend/apps/common/ai.py.
OPENAI_API_KEY=
# Leave empty to call api.openai.com. Point it at an Azure OpenAI resource's
# OpenAI-compatible path (https://<resource>.openai.azure.com/openai/v1/) to
# use that instead with the same key — a deploying platform that provisions
# Azure OpenAI fills this in automatically.
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=gpt-5.6-sol
